# Caddy image with a DNS-01 challenge module ("ClientID" option in acme mode).
# Built by install.sh: docker build --build-arg DNS_MODULE=github.com/caddy-dns/<provider>
ARG CADDY_VERSION=2.11.9
FROM caddy:${CADDY_VERSION}-builder-alpine AS builder
ARG DNS_MODULE
RUN test -n "$DNS_MODULE" && xcaddy build --with "$DNS_MODULE"

FROM caddy:${CADDY_VERSION}-alpine
COPY --from=builder /usr/bin/caddy /usr/bin/caddy

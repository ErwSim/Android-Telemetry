# Caddy: Watchpost TLS front end.
# Variables (infra/.env file, passed by docker compose):
#   WATCHPOST_DOMAIN, WATCHPOST_TLS_MODE (acme|internal), WATCHPOST_ACME_EMAIL, WATCHPOST_ADMIN_ALLOW
#   (CIDRs allowed on siem./adguard., separated by spaces; "0.0.0.0/0 ::/0" = everywhere).
# Files generated by install.sh in infra/data/caddy (mounted on /etc/caddy-generated):
#   admin-auth.caddy (basic_auth account of the administration interfaces),
#   watchpost-client-ca.crt (CA of the collector's client certificates), wazuh-root-ca.pem,
#   dns-site.caddy (DNS site) and, in ClientID mode, dns-challenge.caddy.
{
	import /etc/caddy/tls-{$WATCHPOST_TLS_MODE}.caddy
	admin localhost:2019
	servers {
		# HTTP/3 disabled: a single 443/tcp port to open.
		protocols h1 h2
		timeouts {
			read_body 30s
			read_header 10s
			idle 2m
		}
	}
}

(security) {
	# "?": default value, without overwriting the (stricter) one set by the service.
	header {
		defer
		?Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options "nosniff"
		?X-Frame-Options "SAMEORIGIN"
		?Referrer-Policy "no-referrer"
		?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
		-X-Powered-By
	}
	# No X-Watchpost-* header coming from outside reaches the services.
	request_header -X-Watchpost-*
}

(access_log) {
	log {
		output file /data/logs/access.log {
			roll_size 50MiB
			roll_keep 10
		}
		format json
	}
}

# Administration interfaces: list of allowed addresses, then HTTP authentication.
(admin_protected) {
	@not_allowed not client_ip {$WATCHPOST_ADMIN_ALLOW}
	respond @not_allowed "Access denied" 403
	import /etc/caddy-generated/admin-auth.caddy
}

# ---------------------------------------------------------------------------------------------
# Watchpost console: static files + /api/console/* (including remote commands and the Tracking
# page) + /healthz (authentication by the collector). The only host the console routes go through.
console.{$WATCHPOST_DOMAIN} {
	import security
	import access_log
	request_body {
		max_size 1MB
	}
	# Ingestion goes only through ingest.<domain> (mTLS).
	@ingestion path /api/v1/*
	respond @ingestion 404
	reverse_proxy collector:8080
}

# ---------------------------------------------------------------------------------------------
# Ingestion: client certificate REQUIRED (private CA of the collector), /api/v1/* only.
ingest.{$WATCHPOST_DOMAIN} {
	tls {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy-generated/watchpost-client-ca.crt
		}
	}
	import security
	import access_log
	request_body {
		# Contract §3: 1 MiB compressed, 8 MiB decompressed; an uncompressed batch is allowed.
		# The collector enforces the fine-grained limits (413).
		max_size 9MB
	}
	# Command stream of the agent (SSE, contract §8): permanent connection, a keepalive comment
	# every 120 s (WATCHPOST_CMD_KEEPALIVE_S). Each message is passed on without buffering;
	# no Caddy timeout applies to a response in progress (read_body and idle only cover reading
	# the request and idle connections between two requests). One log line per connection
	# (when it closes), not per message.
	handle /api/v1/commands/stream {
		reverse_proxy collector:8080 {
			header_up X-Watchpost-Client-Cert-Sha256 {http.request.tls.client.fingerprint}
			flush_interval -1
		}
	}
	handle /api/v1/* {
		reverse_proxy collector:8080 {
			# SHA-256 fingerprint (lower-case hex) of the client certificate verified by Caddy.
			header_up X-Watchpost-Client-Cert-Sha256 {http.request.tls.client.fingerprint}
		}
	}
	handle {
		respond 404
	}
}

# ---------------------------------------------------------------------------------------------
# Wazuh dashboard (OpenSearch Dashboards), internal HTTPS with the Wazuh CA.
siem.{$WATCHPOST_DOMAIN} {
	import security
	import access_log
	import admin_protected
	request_body {
		max_size 10MB
	}
	reverse_proxy https://wazuh.dashboard:5601 {
		# Caddy's Basic header must not be taken for indexer credentials.
		header_up -Authorization
		transport http {
			tls_trust_pool file /etc/caddy-generated/wazuh-root-ca.pem
			tls_server_name wazuh.dashboard
		}
	}
}

# ---------------------------------------------------------------------------------------------
# AdGuard Home administration (which also keeps its own account).
adguard.{$WATCHPOST_DOMAIN} {
	import security
	import access_log
	import admin_protected
	request_body {
		max_size 5MB
	}
	reverse_proxy adguardhome:3000 {
		header_up -Authorization
	}
}

# ---------------------------------------------------------------------------------------------
# dns.<domain>: Caddy obtains the certificate that AdGuard Home serves over DoT on port 853.
import /etc/caddy-generated/dns-site.caddy

# "acme" TLS mode: Let's Encrypt certificates (HTTP-01 or TLS-ALPN-01 challenge, ports 80/443).
# Single issuer (no ZeroSSL fallback): AdGuard Home reads the dns.<domain> certificate at a
# fixed path in Caddy's storage (certificates/acme-v02.api.letsencrypt.org-directory/).
email {$WATCHPOST_ACME_EMAIL}
cert_issuer acme

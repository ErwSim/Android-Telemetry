# AdGuard Home: configuration managed by Watchpost (template infra/adguard/AdGuardHome.yaml.tmpl).
# Rendered into data/adguard/watchpost-managed.yaml, then MERGED by infra/adguard/merge-config.py into
# the configuration in service: only the settings managed by Watchpost (admin and
# watchpost-collector accounts, TLS, upstreams, allowed clients, query log, presence of the lists)
# are reapplied on every install.sh; the settings made in the interface and in the Watchpost
# console (blocking level, "watchpost:begin" block) are kept. --reset-adguard starts again from
# this template, keeping the level and the console block. The lists (filters) are built by
# merge-config.py from adguard/levels.json.
schema_version: 34
http:
  # Web interface behind Caddy (adguard.<domain>), never published.
  address: 0.0.0.0:3000
  session_ttl: 24h
  doh:
    routes: []
    insecure_enabled: false
  pprof:
    enabled: false
    port: 6060
# AdGuard Home has a single account type: every account is a full administrator. The
# "watchpost-collector" account is used by the collector (Tracking page, levels, console rules) over
# the internal Docker network; its password (.env: ADGUARD_COLLECTOR_PASSWORD) is therefore worth
# as much as admin's and is protected the same way.
users:
  - name: admin
    password: '@@ADGUARD_ADMIN_HASH@@'
  - name: watchpost-collector
    password: '@@ADGUARD_COLLECTOR_HASH@@'
auth_attempts: 5
block_auth_min: 15
language: en
theme: auto
dns:
  bind_hosts:
    - 0.0.0.0
  # Plain DNS: only on the internal Docker network (WireGuard, diagnostics). Never published.
  port: 53
  serve_plain_dns: true
  anonymize_client_ip: false
  # Rate limiting per client (/24 in IPv4, /56 in IPv6): protects against abuse of the resolver
  # exposed over DoT. The phone rarely makes more than a few queries per second.
  ratelimit: 50
  ratelimit_subnet_len_ipv4: 24
  ratelimit_subnet_len_ipv6: 56
  ratelimit_whitelist: []
  refuse_any: true
  # Encrypted, privacy-respecting upstream: Quad9 (Swiss foundation, no logging of IP
  # addresses, DNSSEC validation, no ECS on dns.quad9.net), over DoH and DoT.
  # Fallback (if Quad9 is unreachable): Mullvad DNS (no filtering, no logging).
  upstream_dns:@@ADGUARD_UPSTREAMS@@
  upstream_dns_file: ""
  bootstrap_dns:
    - 9.9.9.9
    - 149.112.112.112
    - 2620:fe::fe
  fallback_dns:
    - https://dns.mullvad.net/dns-query
  upstream_mode: load_balance
  fastest_timeout: 1s
  # Allowed clients: empty = all (default mode); in ClientID mode: the identifier of the phone +
  # the internal Docker network. The others receive REFUSED.
  allowed_clients:@@ADGUARD_ALLOWED_CLIENTS@@
  disallowed_clients: []
  blocked_hosts:
    - version.bind
    - id.server
    - hostname.bind
  trusted_proxies:
    - 127.0.0.0/8
    - ::1/128
  cache_enabled: true
  cache_size: 4194304
  cache_ttl_min: 0
  cache_ttl_max: 0
  cache_optimistic: false
  bogus_nxdomain: []
  aaaa_disabled: false
  # Requests DNSSEC from the upstream (DO bit); validation is done by Quad9 (SERVFAIL answer if
  # the signature is invalid) and the AD bit is passed on to the phone.
  enable_dnssec: true
  edns_client_subnet:
    custom_ip: ""
    enabled: false
    use_custom: false
  max_goroutines: 300
  handle_ddr: false
  ipset: []
  ipset_file: ""
  bootstrap_prefer_ipv6: false
  upstream_timeout: 10s
  private_networks: []
  use_private_ptr_resolvers: false
  local_ptr_upstreams: []
  use_dns64: false
  dns64_prefixes: []
  serve_http3: false
  use_http3_upstreams: false
  hostsfile_enabled: false
  pending_requests:
    enabled: true
tls:
  enabled: true
  server_name: dns.@@WATCHPOST_DOMAIN@@
  force_https: false
  port_https: 0
  port_dns_over_tls: 853
  port_dns_over_quic: 0
  port_dnscrypt: 0
  dnscrypt_config_file: ""
  certificate_chain: ""
  private_key: ""
  # Certificate obtained and renewed by Caddy (caddy_data volume mounted read-only);
  # AdGuard Home watches these files and reloads them on every renewal.
  certificate_path: @@ADGUARD_CERT_PATH@@
  private_key_path: @@ADGUARD_KEY_PATH@@
  strict_sni_check: false
querylog:
  # Query log: read by the Wazuh manager (adguard_querylog volume), rotated by renaming to
  # querylog.json.1 at every interval.
  dir_path: /opt/adguardhome/querylog
  ignored: []
  interval: 168h
  # Entries kept in memory before being written to disk. 50: the log reaches Wazuh in small
  # batches (no delay of several hours as with the default of 1000); at 1, AdGuard itself loses
  # entries under concurrent queries; above 500 (one API page), the collector's polling
  # (Tracking page, detect.threat_domain) may skip some (contract §8).
  # Managed by Watchpost: reapplied on every install.sh, including on an existing installation.
  size_memory: 50
  enabled: true
  ignored_enabled: false
  file_enabled: true
statistics:
  dir_path: ""
  ignored: []
  interval: 168h
  enabled: true
  ignored_enabled: false
# Blocklists: built by merge-config.py from adguard/levels.json (present at every level,
# enabled according to the chosen level). Fixed identifiers: the Wazuh rules use them
# (FilterListID 30 = threat feed).
filters: []
whitelist_filters: []
user_rules: []
dhcp:
  enabled: false
  interface_name: ""
  local_domain_name: lan
  dhcpv4:
    gateway_ip: ""
    subnet_mask: ""
    range_start: ""
    range_end: ""
    lease_duration: 86400
    icmp_timeout_msec: 1000
    options: []
  dhcpv6:
    range_start: ""
    lease_duration: 86400
    ra_slaac_only: false
    ra_allow_slaac: false
filtering:
  blocking_ipv4: ""
  blocking_ipv6: ""
  blocked_services:
    schedule:
      time_zone: UTC
    ids: []
  protection_disabled_until: null
  safe_search:
    enabled: false
    bing: true
    duckduckgo: true
    ecosia: true
    google: true
    pixabay: true
    yandex: true
    youtube: true
  # Answer 0.0.0.0 / :: for a blocked domain.
  blocking_mode: default
  parental_block_host: family-block.dns.adguard.com
  safebrowsing_block_host: standard-block.dns.adguard.com
  rewrites: []
  # Local lists (committed Watchpost rules) are read only from these directories.
  safe_fs_patterns:
    - /opt/adguardhome/work/userfilters/watchpost/*.txt
    - /opt/adguardhome/work/userfilters/personal/*.txt
  max_http_size: 256MB
  safebrowsing_cache_size: 1048576
  safesearch_cache_size: 1048576
  parental_cache_size: 1048576
  cache_time: 30
  filters_update_interval: 12
  blocked_response_ttl: 10
  filtering_enabled: true
  rewrites_enabled: false
  parental_enabled: false
  safebrowsing_enabled: false
  protection_enabled: true
clients:
  runtime_sources:
    whois: false
    arp: false
    rdns: false
    dhcp: false
    hosts: false
  persistent:@@ADGUARD_CLIENTS@@
log:
  enabled: true
  file: ""
  max_backups: 0
  max_size: 100
  max_age: 3
  compress: false
  local_time: false
  verbose: false
os:
  group: ""
  user: ""
  rlimit_nofile: 0

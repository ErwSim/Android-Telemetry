<!--
  Watchpost Wazuh rules: AdGuard Home query log (querylog.json, one JSON line per query:
  T timestamp, QH requested name, QT type, CP client protocol, IP client, CID ClientID,
  Result.IsFiltered, Result.Reason, Result.Rules[] (not decoded by Wazuh: array of objects),
  Elapsed in ns). The Answer field (DNS answer in base64) is removed before indexing by
  Filebeat (see manager/entrypoint-scripts/watchpost-init.sh).
  Identifiers 100400-100449. Every query is archived (wazuh-archives-*, level 0);
  only the notable situations give an alert.
  AdGuard list identifiers fixed by install.sh: 1 Watchpost base, 2 Watchpost strict,
  10 HaGeZi Pro/Pro++, 20 HaGeZi Samsung, 30 HaGeZi TIF (threats), 90 personal rules.
-->

<group name="watchpost,adguard,dns,">

  <rule id="100400" level="0">
    <decoded_as>json</decoded_as>
    <field name="QH">\S</field>
    <field name="T">^\d\d\d\d-\d\d-\d\dT</field>
    <description>AdGuard: DNS query $(QH) ($(QT)) from $(IP)</description>
    <group>watchpost_dns,</group>
  </rule>

  <!-- Level 1 (no alert) and not 0: needed by the correlation rules below. -->
  <rule id="100401" level="1">
    <if_sid>100400</if_sid>
    <field name="Result.IsFiltered">^true$</field>
    <description>AdGuard: query blocked $(QH)</description>
    <group>watchpost_dns,watchpost_dns_blocked,</group>
  </rule>

  <!-- Domain present in the HaGeZi TIF threat feed (malware, phishing, C2) -->
  <rule id="100402" level="10">
    <if_sid>100401</if_sid>
    <match type="pcre2">"FilterListID":30[,}]</match>
    <description>AdGuard: known malicious domain requested and blocked: $(QH)</description>
    <group>watchpost_dns,watchpost_dns_threat,</group>
  </rule>

  <!-- Burst of blocks: an app that insists (looping telemetry, advertising) or abnormal
       behaviour. Threshold: 60 blocked queries in 2 min for the same client. -->
  <rule id="100403" level="5" frequency="60" timeframe="120" ignore="600">
    <if_matched_sid>100401</if_matched_sid>
    <same_field>IP</same_field>
    <description>AdGuard: burst of blocked queries from $(IP) (last one: $(QH))</description>
    <group>watchpost_dns,watchpost_dns_burst,</group>
  </rule>

  <!-- Burst of queries to threat feed domains: device probably infected -->
  <rule id="100404" level="12" frequency="5" timeframe="600" ignore="1800">
    <if_matched_sid>100402</if_matched_sid>
    <same_field>IP</same_field>
    <description>AdGuard: repeated queries to malicious domains from $(IP)</description>
    <group>watchpost_dns,watchpost_dns_threat,</group>
  </rule>

</group>

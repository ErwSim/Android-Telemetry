<!--
  Règles Wazuh Vigie — événements de l'agent Android (export NDJSON du collecteur, contrat §5).
  Plage d'identifiants : 100100-100299 (événements de l'appareil, et du collecteur pour les
  commandes à distance : 100230-100249), 100300-100349 (sonde
  vigie_watch.py), 100400-100449 (AdGuard Home, fichier vigie_adguard_rules.xml).

  Niveaux : 0 = archivé seulement ; 2 = indicateur pour les tableaux de bord (sous le seuil
  d'alerte) ; 3-5 = information/notable ; 6-9 = à examiner ; 10-12 = sérieux ; 13+ non utilisé.

  Limite importante de Wazuh : un événement ne déclenche qu'UNE règle (la première règle fille
  qui correspond, les filles étant essayées par niveau décroissant). Pour security.posture, les constats sont donc ordonnés du plus grave au moins
  grave ; un défaut moins grave apparaît quand le plus grave est corrigé (et chaque jour, la
  posture étant réémise quotidiennement).

  Les valeurs JSON sont vues par Wazuh comme des chaînes : booléens « true »/« false »,
  nombres en décimal. Les correspondances MITRE ATT&CK sont celles de la matrice MOBILE ; la base
  MITRE embarquée dans Wazuh ne connaît que la matrice Entreprise (une balise <mitre> T1461 y est
  rejetée : « Mitre Technique ID not found in database » et disparaît de l'alerte). Elles sont donc
  portées par un groupe « attack_mobile_<ID> » (rule.groups), filtrable dans le dashboard.
  Tests : infra/wazuh/tests/run-tests.sh (wazuh-logtest dans le conteneur manager).
-->

<group name="vigie,">

  <!-- ========================= Base ========================= -->

  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="vigie.type" type="pcre2">^[a-z0-9_]+\.[a-z0-9_.]+$</field>
    <description>Vigie : $(vigie.type) ($(vigie.device_name))</description>
  </rule>

  <!-- Lignes dérivées de l'export (un élément d'inventaire, d'usage réseau ou de scan Wi-Fi) -->
  <rule id="100101" level="0">
    <if_sid>100100</if_sid>
    <field name="vigie.type" type="pcre2">^(app\.inventory\.app|net\.usage\.app|net\.wifi_scan\.ap)$</field>
    <description>Vigie : élément d'inventaire $(vigie.type)</description>
    <group>vigie_inventory,</group>
  </rule>

  <!-- ========================= agent.* ========================= -->

  <rule id="100110" level="12">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^agent.tamper$</field>
    <description>Vigie : tentative d'altération de l'agent ($(vigie.data.kind)) sur $(vigie.device_name)</description>
<group>vigie_agent,vigie_tamper,attack_mobile_T1629.003,</group>
  </rule>

  <rule id="100111" level="3">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^agent.stopped$</field>
    <description>Vigie : agent arrêté ($(vigie.data.reason)) sur $(vigie.device_name)</description>
    <group>vigie_agent,</group>
  </rule>

  <rule id="100112" level="6">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^agent.buffer_overflow$</field>
    <description>Vigie : tampon de l'agent saturé, $(vigie.data.dropped) événements purgés sur $(vigie.device_name)</description>
    <group>vigie_agent,vigie_data_loss,</group>
  </rule>

  <rule id="100113" level="3">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^agent.collector_error$</field>
    <description>Vigie : erreur du collecteur $(vigie.data.collector) de l'agent</description>
    <group>vigie_agent,</group>
  </rule>

  <rule id="100114" level="3">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^agent.config_changed$</field>
    <description>Vigie : réglage de l'agent modifié ($(vigie.data.key) : $(vigie.data.old) -> $(vigie.data.new))</description>
    <group>vigie_agent,vigie_config,</group>
  </rule>

  <rule id="100115" level="5">
    <if_sid>100114</if_sid>
    <field name="vigie.data.key" type="pcre2">(?i)collector|upload|ingest|enabled</field>
    <field name="vigie.data.new" type="pcre2">^(false|disabled|off)$</field>
    <description>Vigie : une collecte ou l'envoi a été désactivé dans l'agent ($(vigie.data.key))</description>
    <group>vigie_agent,vigie_config,</group>
  </rule>

  <!-- Niveau 2 : la perte du Device Owner est alertée une fois par security.posture_change (100255) ;
       le battement (toutes les 15 min) ne fait que marquer l'état. -->
  <rule id="100116" level="2">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^agent.heartbeat$</field>
    <field name="vigie.data.device_owner">^false$</field>
    <description>Vigie : l'agent n'est plus Device Owner sur $(vigie.device_name) (protections locales inactives)</description>
<group>vigie_agent,vigie_posture,attack_mobile_T1629,</group>
  </rule>

  <!-- ========================= device.* ========================= -->

  <!-- Changement d'heure d'au moins une heure (3 600 000 ms) -->
  <rule id="100120" level="5">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^device.time_changed$</field>
    <field name="vigie.data.delta_ms" type="pcre2">^-?(3[6-9]\d{5}|[4-9]\d{6}|\d{8,})$</field>
    <description>Vigie : horloge de l'appareil modifiée de $(vigie.data.delta_ms) ms</description>
    <group>vigie_device,</group>
  </rule>

  <rule id="100121" level="5">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^device.usb$</field>
    <field name="vigie.data.functions" type="pcre2">\badb\b</field>
    <description>Vigie : connexion USB avec la fonction de débogage ADB active</description>
    <group>vigie_device,vigie_adb,</group>
  </rule>

  <!-- ========================= location.* ========================= -->

  <rule id="100130" level="9">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^location.fix$</field>
    <field name="vigie.data.mock">^true$</field>
    <description>Vigie : position simulée (mock location) reçue du fournisseur $(vigie.data.provider)</description>
    <group>vigie_location,</group>
  </rule>

  <!-- ========================= net.* ========================= -->

  <rule id="100140" level="8">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^net.cell_security$</field>
    <description>Vigie : anomalie de sécurité cellulaire ($(vigie.data.kind))</description>
<group>vigie_network,vigie_cellular,attack_mobile_T1638,</group>
  </rule>

  <rule id="100141" level="10">
    <if_sid>100140</if_sid>
    <field name="vigie.data.kind">^downgrade_2g$</field>
    <description>Vigie : rétrogradation forcée en 2G (station de base factice possible)</description>
<group>vigie_network,vigie_cellular,attack_mobile_T1638,</group>
  </rule>

  <rule id="100142" level="12">
    <if_sid>100140</if_sid>
    <field name="vigie.data.kind">^null_cipher$</field>
    <description>Vigie : connexion cellulaire sans chiffrement (chiffrement nul)</description>
<group>vigie_network,vigie_cellular,attack_mobile_T1638,</group>
  </rule>

  <rule id="100143" level="10">
    <if_sid>100140</if_sid>
    <field name="vigie.data.kind">^identifier_disclosure$</field>
    <description>Vigie : divulgation de l'identifiant d'abonné demandée par le réseau (IMSI-catcher possible)</description>
<group>vigie_network,vigie_cellular,attack_mobile_T1638,</group>
  </rule>

  <rule id="100145" level="10">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^net.ble_tracker$</field>
    <description>Vigie : traceur Bluetooth ($(vigie.data.kind)) qui suit l'appareil, vu $(vigie.data.sightings) fois</description>
    <group>vigie_network,vigie_stalking,</group>
  </rule>

  <rule id="100146" level="4">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^net.wifi$</field>
    <field name="vigie.data.event">^connected$</field>
    <field name="vigie.data.security" type="pcre2">(?i)^(open|none|wep|owe_transition)$</field>
    <description>Vigie : connexion à un réseau Wi-Fi ouvert ou faible ($(vigie.data.ssid), $(vigie.data.security))</description>
    <group>vigie_network,</group>
  </rule>

  <rule id="100147" level="5">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^net.connectivity$</field>
    <field name="vigie.data.validated">^true$</field>
    <field name="vigie.data.private_dns_active">^false$</field>
    <description>Vigie : réseau actif sans DNS privé (les requêtes DNS échappent au filtrage)</description>
<group>vigie_network,vigie_dns,attack_mobile_T1629,</group>
  </rule>

  <!-- Requêtes DNS d'une app vers des domaines de télémétrie/publicité Google ou Samsung.
       Niveau 2 : pas d'alerte, mais l'événement est marqué (rule.id, groupe vigie_telemetry) dans
       wazuh-archives-* pour les tableaux de bord « qui piste quoi ». -->
  <rule id="100148" level="2">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^net.dns$</field>
    <field name="vigie.data.hostname" type="pcre2">(?i)(^|\.)(app-measurement\.com|firebaselogging(-pa)?\.googleapis\.com|firebasecrashlytics\.googleapis\.com|crashlyticsreports-pa\.googleapis\.com|crashlytics\.com|google-analytics\.com|googletagmanager\.com|doubleclick\.net|googlesyndication\.com|googleadservices\.com|adservice\.google\.com|play-services-telemetry\.googleapis\.com|clientmetrics-pa\.googleapis\.com|samsungads\.com|dc\.di\.atlas\.samsung\.com|analytics\.samsungknox\.com|gos-gsp\.io)$</field>
    <description>Vigie : $(vigie.data.package) contacte un domaine de télémétrie ($(vigie.data.hostname))</description>
    <group>vigie_network,vigie_telemetry,</group>
  </rule>

  <!-- ========================= app.* ========================= -->

  <rule id="100150" level="3">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^app.installed$</field>
    <description>Vigie : app installée $(vigie.data.package) $(vigie.data.version_name) (installateur $(vigie.data.installer))</description>
    <group>vigie_app,</group>
  </rule>

  <!-- Installée par autre chose que le Play Store ou le Galaxy Store -->
  <rule id="100151" level="8">
    <if_sid>100150</if_sid>
    <field name="vigie.data.installer" type="pcre2" negate="yes">^(com\.android\.vending|com\.sec\.android\.app\.samsungapps)$</field>
    <description>Vigie : app installée hors Play Store : $(vigie.data.package) (installateur $(vigie.data.installer))</description>
    <group>vigie_app,vigie_sideload,</group>
  </rule>

  <!-- Aucun installateur déclaré : typiquement « adb install » -->
  <rule id="100152" level="8">
    <if_sid>100150</if_sid>
    <match type="pcre2" negate="yes">"installer":</match>
    <description>Vigie : app installée sans installateur déclaré (ADB ?) : $(vigie.data.package)</description>
    <group>vigie_app,vigie_sideload,vigie_adb,</group>
  </rule>

  <rule id="100153" level="3">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^app.removed$</field>
    <description>Vigie : app désinstallée $(vigie.data.package)</description>
    <group>vigie_app,</group>
  </rule>

  <!-- Accès spéciaux : l'événement est émis à chaque changement ET une fois par jour. On alerte
       quand la liste diffère de celle d'un événement précédent du même appareil (fenêtre de 25 h,
       qui couvre la réémission quotidienne). « ignore » évite de réalerter à chaque réémission
       pendant 25 h ; contrepartie : un second changement de la même liste dans ces 25 h n'alerte pas
       (la console Vigie garde l'historique complet de la posture).
       Niveau 1 (et non 0) : Wazuh ne mémorise pas les événements de niveau 0 pour les règles de
       corrélation (if_matched_sid) ; le niveau 1 reste sous le seuil d'alerte. -->
  <rule id="100155" level="1">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^app.special_access$</field>
    <description>Vigie : état des accès spéciaux des apps</description>
    <group>vigie_app,</group>
  </rule>

  <rule id="100156" level="10" frequency="2" timeframe="90000" ignore="90000">
    <if_matched_sid>100155</if_matched_sid>
    <same_field>vigie.device_id</same_field>
    <different_field>vigie.data.accessibility_services</different_field>
    <description>Vigie : la liste des services d'accessibilité a changé : $(vigie.data.accessibility_services)</description>
<group>vigie_app,vigie_special_access,attack_mobile_T1453,</group>
  </rule>

  <rule id="100157" level="10" frequency="2" timeframe="90000" ignore="90000">
    <if_matched_sid>100155</if_matched_sid>
    <same_field>vigie.device_id</same_field>
    <different_field>vigie.data.device_admins</different_field>
    <description>Vigie : la liste des administrateurs de l'appareil a changé : $(vigie.data.device_admins)</description>
<group>vigie_app,vigie_special_access,attack_mobile_T1626.001,</group>
  </rule>

  <rule id="100158" level="8" frequency="2" timeframe="90000" ignore="90000">
    <if_matched_sid>100155</if_matched_sid>
    <same_field>vigie.device_id</same_field>
    <different_field>vigie.data.notification_listeners</different_field>
    <description>Vigie : la liste des apps qui lisent les notifications a changé : $(vigie.data.notification_listeners)</description>
<group>vigie_app,vigie_special_access,attack_mobile_T1517,</group>
  </rule>

  <rule id="100159" level="7" frequency="2" timeframe="90000" ignore="90000">
    <if_matched_sid>100155</if_matched_sid>
    <same_field>vigie.device_id</same_field>
    <different_field>vigie.data.vpn_apps</different_field>
    <description>Vigie : la liste des apps VPN a changé : $(vigie.data.vpn_apps)</description>
    <group>vigie_app,vigie_special_access,</group>
  </rule>

  <rule id="100160" level="5">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^app.permission_changed$</field>
    <field name="vigie.data.granted">^true$</field>
    <field name="vigie.data.permission" type="pcre2">(ACCESS_BACKGROUND_LOCATION|RECORD_AUDIO|CAMERA|READ_SMS|RECEIVE_SMS|READ_CALL_LOG|READ_CONTACTS|BODY_SENSORS|MANAGE_EXTERNAL_STORAGE|SYSTEM_ALERT_WINDOW|REQUEST_INSTALL_PACKAGES)$</field>
    <description>Vigie : permission sensible accordée à $(vigie.data.package) ($(vigie.data.permission))</description>
    <group>vigie_app,vigie_permission,</group>
  </rule>

  <!-- ========================= sensor.* ========================= -->
  <!-- Tout usage est marqué (niveau 2) pour les tableaux de bord. Les événements portent l'état de
       l'écran (screen_on) et du verrouillage (locked) : un usage appareil verrouillé, ou écran
       éteint hors appel (le capteur de proximité éteint l'écran pendant un appel), est alerté. -->

  <rule id="100170" level="2">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^sensor.microphone$</field>
    <field name="vigie.data.recording">^true$</field>
    <description>Vigie : micro utilisé par $(vigie.data.package)</description>
    <group>vigie_sensor,</group>
  </rule>

  <rule id="100171" level="2">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^sensor.camera$</field>
    <field name="vigie.data.in_use">^true$</field>
    <description>Vigie : caméra $(vigie.data.camera_id) utilisée par $(vigie.data.package)</description>
    <group>vigie_sensor,</group>
  </rule>

  <rule id="100172" level="10">
    <if_sid>100170</if_sid>
    <field name="vigie.data.locked">^true$</field>
    <description>Vigie : micro utilisé par $(vigie.data.package) alors que l'appareil est verrouillé</description>
    <group>vigie_sensor,vigie_hidden_capture,attack_mobile_T1429,</group>
  </rule>

  <rule id="100173" level="6">
    <if_sid>100170</if_sid>
    <field name="vigie.data.screen_on">^false$</field>
    <field name="vigie.data.source" type="pcre2" negate="yes">^voice_(communication|call)$</field>
    <description>Vigie : micro utilisé écran éteint, hors appel, par $(vigie.data.package) (source $(vigie.data.source))</description>
    <group>vigie_sensor,vigie_hidden_capture,attack_mobile_T1429,</group>
  </rule>

  <rule id="100174" level="10">
    <if_sid>100171</if_sid>
    <field name="vigie.data.locked">^true$</field>
    <description>Vigie : caméra $(vigie.data.camera_id) utilisée par $(vigie.data.package) alors que l'appareil est verrouillé</description>
    <group>vigie_sensor,vigie_hidden_capture,attack_mobile_T1512,</group>
  </rule>

  <rule id="100175" level="8">
    <if_sid>100171</if_sid>
    <field name="vigie.data.screen_on">^false$</field>
    <description>Vigie : caméra $(vigie.data.camera_id) utilisée écran éteint par $(vigie.data.package)</description>
    <group>vigie_sensor,vigie_hidden_capture,attack_mobile_T1512,</group>
  </rule>

  <!-- ========================= security.keyguard / ca_cert / policy ========================= -->

  <rule id="100180" level="3">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^security.keyguard$</field>
    <field name="vigie.data.event">^unlock_failed$</field>
    <description>Vigie : échec de déverrouillage de l'écran ($(vigie.data.failed_attempts) tentatives)</description>
    <group>vigie_security,vigie_keyguard,authentication_failed,</group>
  </rule>

  <rule id="100181" level="10" frequency="5" timeframe="600">
    <if_matched_sid>100180</if_matched_sid>
    <same_field>vigie.device_id</same_field>
    <description>Vigie : déverrouillages échoués répétés (5 en 10 min) sur $(vigie.device_name)</description>
<group>vigie_security,vigie_keyguard,authentication_failures,attack_mobile_T1461,</group>
  </rule>

  <rule id="100182" level="10">
    <if_sid>100180</if_sid>
    <field name="vigie.data.failed_attempts" type="pcre2">^([1-9]\d+)$</field>
    <description>Vigie : $(vigie.data.failed_attempts) échecs de déverrouillage consécutifs</description>
<group>vigie_security,vigie_keyguard,authentication_failures,attack_mobile_T1461,</group>
  </rule>

  <rule id="100185" level="10">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^security.ca_cert$</field>
    <field name="vigie.data.event">^added$</field>
    <description>Vigie : autorité de certification utilisateur ajoutée ($(vigie.data.subject))</description>
<group>vigie_security,vigie_ca,attack_mobile_T1638,</group>
  </rule>

  <rule id="100186" level="3">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^security.ca_cert$</field>
    <field name="vigie.data.event">^removed$</field>
    <description>Vigie : autorité de certification utilisateur retirée ($(vigie.data.subject))</description>
    <group>vigie_security,vigie_ca,</group>
  </rule>

  <rule id="100187" level="5">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^security.policy$</field>
    <field name="vigie.data.ok">^false$</field>
    <description>Vigie : échec d'une action de politique Device Owner ($(vigie.data.action) $(vigie.data.target))</description>
    <group>vigie_security,vigie_policy,</group>
  </rule>

  <!-- ========================= security.posture (état complet) ========================= -->
  <!-- Chaque CHANGEMENT de posture arrive aussi en security.posture_change (un événement par champ)
       et y est alerté (règles 100250-100269). Pour ne pas alerter deux fois le même fait, les
       constats sur l'état complet sont ici de niveau 2 : pas d'alerte, mais l'événement est marqué
       (groupe vigie_posture_state) pour les tableaux de bord. Seul l'âge du correctif, qui n'est pas
       un changement de l'appareil, alerte ici (au plus une fois par semaine).
       Limite : un défaut DÉJÀ présent à l'enrôlement ne produit pas de changement, donc pas
       d'alerte : vérifier la posture initiale dans la console après l'enrôlement. -->

  <rule id="100190" level="0">
    <if_sid>100100</if_sid>
    <field name="vigie.type">^security.posture$</field>
    <description>Vigie : posture de sécurité de $(vigie.device_name)</description>
    <group>vigie_posture,vigie_posture_state,</group>
  </rule>

  <rule id="100191" level="2">
    <if_sid>100190</if_sid>
    <field name="vigie.data.verified_boot_state" type="pcre2">(?i)^(orange|yellow|red)$</field>
    <description>Vigie : démarrage vérifié « $(vigie.data.verified_boot_state) » (chargeur d'amorçage déverrouillé ou système modifié)</description>
    <group>vigie_posture,vigie_posture_state,</group>
  </rule>

  <rule id="100192" level="2">
    <if_sid>100190</if_sid>
    <field name="vigie.data.encrypted">^false$</field>
    <description>Vigie : stockage de l'appareil non chiffré</description>
    <group>vigie_posture,vigie_posture_state,</group>
  </rule>

  <rule id="100193" level="2">
    <if_sid>100190</if_sid>
    <field name="vigie.data.device_owner">^false$</field>
    <description>Vigie : l'agent n'est pas (ou plus) Device Owner (protections locales inactives)</description>
<group>vigie_posture,vigie_posture_state,attack_mobile_T1629,</group>
  </rule>

  <rule id="100194" level="2">
    <if_sid>100190</if_sid>
    <field name="vigie.data.private_dns_mode" type="pcre2">^(?!hostname$|provider_hostname$)</field>
    <description>Vigie : DNS privé désactivé ou non strict (mode $(vigie.data.private_dns_mode))</description>
<group>vigie_posture,vigie_posture_state,vigie_dns,attack_mobile_T1629,</group>
  </rule>

  <rule id="100195" level="2">
    <if_sid>100190</if_sid>
    <list field="vigie.data.private_dns_host" lookup="not_match_key">etc/lists/vigie-private-dns-hosts</list>
    <description>Vigie : DNS privé pointé vers un hôte inattendu ($(vigie.data.private_dns_host))</description>

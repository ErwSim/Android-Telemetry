{
  "version": 1,
  "lists": {
    "adguard_dns": {
      "name": "AdGuard DNS filter",
      "url": "https://adguardteam.github.io/HostlistsRegistry/assets/filter_1.txt",
      "category": "mixed"
    },
    "hagezi_tif": {
      "name": "HaGeZi - Threat Intelligence Feeds (medium)",
      "url": "https://raw.githubusercontent.com/hagezi/dns-blocklists/main/adblock/tif.medium.txt",
      "category": "threat"
    },
    "hagezi_samsung": {
      "name": "HaGeZi - Native Tracker Samsung",
      "url": "https://raw.githubusercontent.com/hagezi/dns-blocklists/main/adblock/native.samsung.txt",
      "category": "tracking"
    },
    "hagezi_tiktok": {
      "name": "HaGeZi - Native Tracker TikTok",
      "url": "https://raw.githubusercontent.com/hagezi/dns-blocklists/main/adblock/native.tiktok.txt",
      "category": "tracking"
    },
    "hagezi_microsoft": {
      "name": "HaGeZi - Native Tracker Microsoft",
      "url": "https://raw.githubusercontent.com/hagezi/dns-blocklists/main/adblock/native.winoffice.txt",
      "category": "tracking"
    },
    "hagezi_pro_plus": {
      "name": "HaGeZi - Multi PRO++",
      "url": "https://raw.githubusercontent.com/hagezi/dns-blocklists/main/adblock/pro.plus.txt",
      "category": "mixed"
    }
  },
  "levels": [
    {
      "key": "permissive",
      "name": "Permissive",
      "description": "Threats (phishing, malware, command servers), advertising and common trackers only. Everything keeps working.",
      "lists": ["adguard_dns", "hagezi_tif"]
    },
    {
      "key": "balanced",
      "name": "Balanced",
      "description": "Adds Samsung, TikTok and Microsoft telemetry. Play Services, the Play Store, push notifications and banking apps keep working.",
      "lists": ["adguard_dns", "hagezi_tif", "hagezi_samsung", "hagezi_tiktok", "hagezi_microsoft"]
    },
    {
      "key": "strict",
      "name": "Strict",
      "description": "Adds an extended list (Google telemetry included). Some applications may malfunction.",
      "lists": ["adguard_dns", "hagezi_tif", "hagezi_samsung", "hagezi_tiktok", "hagezi_microsoft", "hagezi_pro_plus"]
    }
  ]
}

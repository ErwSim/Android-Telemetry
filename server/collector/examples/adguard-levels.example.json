    },
    {
      "key": "strict",
      "name": "Strict",
      "description": "Ajoute une liste étendue (télémétrie Google comprise). Certaines applications peuvent mal fonctionner.",
      "lists": ["adguard_dns", "hagezi_tif", "hagezi_samsung", "hagezi_tiktok", "hagezi_microsoft", "hagezi_pro_plus"]

    <string name="journal_pending_intro">Les 200 événements les plus récents encore dans le tampon de l\'appareil.</string>
    <string name="journal_empty">Aucun événement.</string>

    <!-- Settings -->
    <string name="settings_buffer_title">Tampon et envoi</string>
    <string name="setting_buffer_max">Taille maximale du tampon</string>
    <string name="setting_buffer_max_summary">Au-delà, les événements les plus anciens et les moins graves sont supprimés (signalé par agent.buffer_overflow).</string>
    <string name="setting_buffer_age">Âge maximal des événements en attente</string>
    <string name="setting_buffer_age_summary">Les événements non envoyés plus anciens sont supprimés.</string>
    <string name="setting_upload_interval">Intervalle d\'envoi</string>
    <string name="setting_upload_interval_summary">Envoi groupé périodique (15 min minimum). Les événements graves et le retour du réseau déclenchent un envoi plus tôt.</string>
    <string name="setting_wifi_only">Gros volumes en Wi-Fi seulement</string>
    <string name="setting_wifi_only_summary">Sur un réseau mesuré, si le tampon dépasse le seuil, seuls les événements graves sont envoyés ; le reste attend un réseau non mesuré.</string>
    <string name="setting_large_threshold">Seuil « gros volume »</string>
    <string name="setting_large_threshold_summary">Volume en attente au-delà duquel l\'option Wi-Fi s\'applique.</string>

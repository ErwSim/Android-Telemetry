    <!-- Enrollment -->
    <string name="enroll_new_title">Enrôler cet appareil</string>
    <string name="enroll_explanation">Choisissez le fichier .vigie produit par « vigie-collector enroll » sur votre serveur (copié par câble, par exemple dans Téléchargements). La clé privée est importée dans le Keystore Android (non exportable) puis oubliée ; le jeton est chiffré sur l\'appareil.</string>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Default network state (private DNS guard: validation of the network). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        Package visibility: the policy engine checks which catalog packages are installed, resolves
        the uid of network log entries (including shared uids) and finds the default launcher,
        dialer, keyboards and VPN apps (deny list). Sideloaded app: no Play policy applies.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!--
        Granted only by ADB (scripts/grant-adb-permissions): anti-tracking Global settings that the
        Device Owner allowlist does not cover (ble_scan_always_enabled). Optional.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application>
        <!--
            Device admin receiver. Activated as Device Owner by ADB only:
            adb shell dpm set-device-owner io.github.erwsim.watchpost/io.github.erwsim.watchpost.policy.WatchpostAdminReceiver
        -->
        <receiver
            android:name=".WatchpostAdminReceiver"
            android:description="@string/policy_admin_description"
            android:exported="true"
            android:label="@string/policy_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
            ADB rescue ("Tout rétablir" without the UI): scripts/rescue-revert.sh / .ps1.
            The sender must hold FORCE_STOP_PACKAGES (signature|privileged, not grantable to
            third-party apps, even by "pm grant"): only the system and the ADB shell can send it.
            It can only UNDO Watchpost's own policy, never apply anything.
        -->
        <receiver
            android:name=".rescue.RescueReceiver"
            android:exported="true"
            android:permission="android.permission.FORCE_STOP_PACKAGES"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="io.github.erwsim.watchpost.action.RESCUE_REVERT_ALL" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Framework theme only (no AndroidX in the companion). DayNight: follows the system's dark mode. -->
    <style name="Theme.WatchpostNotifier" parent="@android:style/Theme.DeviceDefault.DayNight" />

    <style name="Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
        <item name="android:textIsSelectable">true</item>
    </style>

    <style name="Header">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:textAppearance">?android:attr/textAppearanceLarge</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <style name="Action">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="ListField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minLines">4</item>
        <item name="android:maxLines">12</item>
        <item name="android:gravity">top|start</item>
        <item name="android:inputType">textMultiLine|textNoSuggestions</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
